APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_REQUEST_BYTES=1048576
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_CORS_ALLOW_CREDENTIALS=false
HTTP_CLIENT_IP_MODE=remote
HTTP_CLIENT_IP_HEADER=X-Real-IP
HTTP_TRUSTED_PROXY_CIDRS=
HTTP_TRUSTED_PROXY_COUNT=1
SHUTDOWN_DRAIN_DELAY=0s
SHUTDOWN_TIMEOUT=10s
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=5s
